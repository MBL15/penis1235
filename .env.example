# Скопируйте в .env и заполните нужное. Всё необязательное: без ключей работает режим «без ИИ».

# База данных (по умолчанию SQLite-файл afisha.db в корне проекта).
# Для продакшена: postgresql+psycopg://user:pass@host/dbname
# DATABASE_URL=

# Ключ для POST/PATCH-эндпоинтов приёма событий (заголовок X-API-Key). Пусто = приём отключён.
# Не короче 24 символов, иначе приём тоже отключён. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# --- Защита (всё необязательно, значения по умолчанию разумные) ---
# Имена хоста, на которые отвечает сервис, через запятую. В продакшене укажите свой домен.
# ALLOWED_HOSTS=afisha.example.ru,127.0.0.1,localhost
# Сервис стоит за своим прокси (nginx): адрес посетителя берётся из X-Forwarded-For. Без прокси не включайте.
# TRUST_PROXY=1
# Общий лимит запросов к API с одного адреса в минуту.
# API_RATE_LIMIT=300
# Бюджет ИИ: одновременных запросов к модели, запросов за сутки (0 = без лимита), секунд на один ответ.
# LLM_MAX_CONCURRENCY=4
# LLM_DAILY_LIMIT=3000
# LLM_TIME_BUDGET=45

# ИИ-помощник работает на Google Gemini. Без ключа отвечает режим «без ИИ» (разбор запроса по правилам).
# AGENT_MODE=auto|llm|rules   (rules = никогда не вызывать модель)
# Ключ Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

# Telegram-бот (токен от @BotFather)
TELEGRAM_BOT_TOKEN=
# Прокси для Telegram, если он недоступен напрямую (например, http://127.0.0.1:10809)
TELEGRAM_PROXY=
# Обязательная подписка на канал (по умолчанию @sz_orenteam). Бот должен быть администратором этого канала.
# Пустое значение отключает проверку.
# REQUIRED_CHANNEL=@sz_orenteam
# REQUIRED_CHANNEL_TITLE=SpaceZ

# Публичный адрес сервиса (для ссылок из бота и виджета)
PUBLIC_URL=http://localhost:8000

# Пометка «неофициальный сервис» для бота и описания API (текст по умолчанию уже есть; страницы сайта и виджета хранят свою копию).
# DISCLAIMER=

# --- Только для docker compose ---
# Порт на вашей машине и загрузка набора реальных событий (data/sample_events.json) при первом запуске.
# WEB_PORT=8000
# LOAD_SAMPLE_DATA=1
